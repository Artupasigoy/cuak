#!/bin/bash
# cuak: CLI penjaga sesi SSH human-like. Menu: add | status | logs | remove | test | exit.
DEVDIR=/etc/cuak/devices; KEYDIR=/etc/cuak/keys; LOGDIR=/var/log/cuak
mkdir -p "$DEVDIR" "$KEYDIR" "$LOGDIR" /run 2>/dev/null
exec 200>/run/cuak-cli.lock 2>/dev/null && flock 200 2>/dev/null || true
need_root(){ [ "$(id -u)" = 0 ] || { echo "GAGAL: butuh akses root. Jalankan: sudo cuak"; return 1; }; }
valid_alias(){ [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]]; }
unit(){ echo "cuak-holder@$1.service"; }
ask(){ # ask "judul" "default" varname -> return 1 bila Esc (kembali)
  local judul="$1" def="$2" __v="$3" val
  echo "--- $judul ---"
  if [ -n "$def" ]; then read -rp "> [default: $def | Esc=kembali]: " val || return 1; val=${val:-$def};
  else read -rp "> [Esc=kembali]: " val || return 1; fi
  if [[ "$val" == *$'\e'* ]]; then echo "(kembali)"; return 1; fi
  printf -v "$__v" '%s' "$val"
}
cmd_add(){
  need_root || return 1
  echo "=== tambah device ==="
  local hp h pt u k a
  ask "langkah 1/4: IP dan port server SSH (contoh 192.168.1.10:22)" "" hp || return 0
  if [[ "$hp" =~ ^\[(.+)\](:([0-9]+))?$ ]]; then h="${BASH_REMATCH[1]}"; pt="${BASH_REMATCH[3]:-22}"; # [::1]:22
  elif [[ "$hp" == *::* || "$hp" == *:*:* ]]; then h="$hp"; pt=22; # IPv6 tanpa bracket
  elif [[ "$hp" == *:* ]]; then h="${hp%:*}"; pt="${hp##*:}"; else h="$hp"; pt=22; fi
  [[ "$pt" =~ ^[0-9]+$ ]] && [ "$pt" -ge 1 ] && [ "$pt" -le 65535 ] || { echo "GAGAL: port '$pt' tidak valid. Pakai angka 1-65535, contoh 192.168.1.10:22."; return 0; }
  [ -n "$h" ] || { echo "GAGAL: IP/host kosong. Contoh: 192.168.1.10:22"; return 0; }
  [[ "$h" =~ ^[A-Za-z0-9._:-]+$ ]] || { echo "GAGAL: host '$h' mengandung karakter tak diizinkan."; return 0; }
  ask "langkah 2/4: user login SSH di server (contoh ubuntu)" "ubuntu" u || return 0
  [[ "$u" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "GAGAL: user '$u' tak valid (huruf/angka/._-)."; return 0; }
  local defk=""
  for cand in /root/.ssh/id_ed25519 /root/.ssh/id_rsa ${SUDO_USER:+/home/$SUDO_USER/.ssh/id_ed25519} ${SUDO_USER:+/home/$SUDO_USER/.ssh/id_rsa}; do
    [ -f "$cand" ] && { defk="$cand"; break; }
  done
  [ -n "$defk" ] || defk="/root/.ssh/id_ed25519"
  echo "  (praktik terbaik: service jalan sebagai root -> key root didahulukan; key disalin ke /etc/cuak/keys/ agar terisolasi per device)"
  ask "langkah 3/4: path private key di mesin ini (contoh /home/pi/.ssh/id_rsa)" "$defk" k || return 0
  k=${k/#\~/$HOME}
  if [ ! -f "$k" ]; then
    echo "GAGAL: key '$k' tidak ditemukan."
    local mk; ask "buatkan key ed25519 baru di '$k'? (Y/n)" "Y" mk || return 0
    if [[ "$mk" =~ ^[Yy]$ ]]; then
      mkdir -p "$(dirname "$k")"; ssh-keygen -t ed25519 -f "$k" -N "" -q && chmod 600 "$k" || { echo "GAGAL: ssh-keygen gagal."; return 0; }
      echo "OK: key dibuat. WAJIB daftarkan ke server dulu:"; echo "  ssh-copy-id -i $k $u@$h -p $pt"
      return 0
    fi
    echo "(kembali ke menu)"; return 0
  fi
  ask "langkah 4/4: alias device (contoh vps-rumah)" "" a || return 0
  valid_alias "$a" || { echo "GAGAL: alias tidak valid. Aturan: huruf kecil/angka/strip, contoh: vps-rumah."; return 0; }
  [ -f "$DEVDIR/$a.conf" ] && { echo "GAGAL: device '$a' sudah terdaftar. Hapus dulu via menu 4, atau pakai alias lain."; return 0; }
  echo "--- ringkasan: $a = $u@$h:$pt (key $k) ---"
  cp "$k" "$KEYDIR/$a"; chmod 600 "$KEYDIR/$a"
  printf 'HOST=%s\nPORT=%s\nUSER=%s\nKEY=%s\nPING1=1.1.1.1\nPING2=8.8.8.8\n' "$h" "$pt" "$u" "$KEYDIR/$a" >"$DEVDIR/$a.conf"
  chmod 600 "$DEVDIR/$a.conf"
  echo "-- test koneksi dgn opsi IDENTIK produksi (BatchMode, 15 dtk) --"
  local out
  if ! out=$(ssh -n -o BatchMode=yes -o IdentitiesOnly=yes -o UserKnownHostsFile="$KEYDIR/$a.hosts" -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new -p "$pt" -i "$KEYDIR/$a" "$u@$h" true 2>&1); then
    echo "GAGAL: koneksi ke $u@$h:$pt gagal."
    if grep -qiE "timed out|unreachable|no route to host" <<<"$out"; then
      echo "  sebab: host/port tak terjangkau. Cek IP, port $pt terbuka, dan firewall server."
    elif grep -qiE "denied|publickey|authentication|permission" <<<"$out"; then
      echo "  sebab: key ditolak server. Daftarkan dulu:"; echo "    ssh-copy-id -i $k $u@$h -p $pt"
    else echo "  detail: $(echo "$out" | head -n2)"; fi
    rm -f "$DEVDIR/$a.conf" "$KEYDIR/$a" "$KEYDIR/$a.hosts"
    return 0
  fi
  systemctl enable "$(unit "$a")" >/dev/null 2>&1 || echo "WARN: auto-start reboot GAGAL disetel (cek template unit). Holder tetap bisa start manual." 
  read -rp "start sekarang? [Y/n]: " s || s=n
  if [[ "$s" =~ ^[Nn] ]]; then echo "(tidak di-start. Start manual: sudo systemctl start $(unit "$a"))";
  elif systemctl start "$(unit "$a")"; then true;
  else echo "WARN: start gagal. Cek: sudo journalctl -u $(unit "$a") -n 20"; fi
  echo "SUKSES: device '$a' aktif. Rincian: holder autossh primer + fallback ssh, auto-start reboot ON, log di $LOGDIR/$a.log. Pantau via menu: 2 (status)."
}
cmd_status(){
  printf '%-14s %-8s %-12s %s\n' ALIAS UNIT LAST-SEEN DETAIL
  for c in "$DEVDIR"/*.conf; do
    [ -f "$c" ] || { echo "(belum ada device. Tambah dulu via menu 1: add device)"; return 0; }
    a=$(basename "$c" .conf); u=$(unit "$a"); log="$LOGDIR/$a.log"
    st=$(systemctl is-active "$u" 2>/dev/null)
    last="belum-pernah"; age="-"
    if [ -f "$log" ]; then last=$(tail -n1 "$log" | cut -c1-60); age=$(($(date +%s)-$(stat -c %Y "$log")))
      age="${age}s-lalu"; fi
    printf '%-14s %-8s %-12s %s\n' "$a" "$st" "$age" "$last"
  done
}
v_alias(){ valid_alias "$1" || { echo "GAGAL: alias tidak valid (huruf-kecil/angka/strip)."; return 1; }; }
cmd_logs(){ a="${1:-}"; if [ -z "$a" ]; then ask "log device mana? (alias, contoh vps-rumah)" "" a || return 0; fi
  v_alias "$a" || return 1
  [ -f "$LOGDIR/$a.log" ] || { echo "GAGAL: belum ada log untuk '$a' (holder belum pernah jalan?)."; return 1; }
  tail -n 30 "$LOGDIR/$a.log"; }
cmd_remove(){ need_root || return 1; a="${1:-}"; if [ -z "$a" ]; then ask "hapus device mana? (alias, contoh vps-rumah)" "" a || return 0; fi
  v_alias "$a" || return 1
  local cfm; ask "ketik YA untuk hapus device '$a'" "" cfm || return 0
  [[ "$cfm" =~ ^[Yy][Aa]$ ]] || { echo "(batal hapus)"; return 0; }
  [ -f "$DEVDIR/$a.conf" ] || { echo "GAGAL: device '$a' tidak terdaftar. Tambah dulu via menu 1."; return 1; }
  systemctl stop "$(unit "$a")" 2>/dev/null; systemctl disable "$(unit "$a")" >/dev/null 2>&1
  rm -f "$DEVDIR/$a.conf" "$KEYDIR/$a" "$KEYDIR/$a.hosts"; pkill -f -- "-i $KEYDIR/$a($| )" 2>/dev/null; echo "SUKSES: '$a' dihentikan + dihapus (unit off, auto-start off). Arsip log tetap ada di $LOGDIR/$a.log."; }
cmd_test(){ a="${1:-}"; if [ -z "$a" ]; then ask "test device mana? (alias, contoh vps-rumah)" "" a || return 0; fi
  v_alias "$a" || return 1
  # shellcheck disable=SC1090
  [ -f "$DEVDIR/$a.conf" ] || { echo "GAGAL: device '$a' tidak terdaftar. Tambah dulu via menu 1."; return 1; }
  . "$DEVDIR/$a.conf"
  echo "-- ssh true (opsi identik produksi) --"; time ssh -n -o BatchMode=yes -o IdentitiesOnly=yes -o UserKnownHostsFile="${KEY}.hosts" -o ConnectTimeout=15 -p "$PORT" -i "$KEY" "$USER@$HOST" true && echo OK-ssh
  echo "-- ping target human-sim --"; ping -c2 -W2 "$PING1"; ping -c2 -W2 "$PING2"; }
cmd_doctor(){
  ok=1
  for b in ssh ping systemctl flock autossh; do
    if command -v "$b" >/dev/null 2>&1; then echo "OK   $b: $(command -v "$b")";
    elif [ "$b" = autossh ]; then echo "WARN autossh hilang (fallback ssh aktif). Jalankan installer untuk paksa install."; ok=0;
    else echo "FAIL $b hilang. Jalankan installer."; ok=0; fi
  done
  [ -d /run/systemd/system ] && echo "OK   systemd" || { echo "FAIL bukan systemd"; ok=0; }
  for f in /etc/systemd/system/cuak-holder@.service /usr/local/lib/cuak/cuak-holder.sh /usr/local/lib/cuak/cuak-watchdog.sh; do
    [ -f "$f" ] && echo "OK   $f" || { echo "FAIL $f hilang. Jalankan installer."; ok=0; }
  done
  systemctl is-active -q cuak-watchdog.timer && echo "OK   watchdog timer aktif" || echo "WARN watchdog timer mati"
  n=$(ls /etc/cuak/devices/*.conf 2>/dev/null | wc -l); echo "INFO $n device terdaftar"
  return $((1-ok))
}
pick_idx(){ # $1..$n = item; echo index terpilih (0-based), atau 255 bila Esc/q
  local -a items=("$@"); local n=${#items[@]} sel=0 k k2 i
  exec 3>&1 1>&2  # UI -> stderr, hasil -> stdout
  tput civis 2>/dev/null
  printf '=== cuak === (atas/bawah + Enter)\n'
  for i in "${!items[@]}"; do printf '\n'; done
  while true; do
    tput cuu "$n" 2>/dev/null
    for i in "${!items[@]}"; do
      if [ "$i" = "$sel" ]; then printf '\e[7m> %d. %s\e[0m\e[K\n' "$((i+1))" "${items[$i]}";
      else printf '  %d. %s\e[K\n' "$((i+1))" "${items[$i]}"; fi
    done
    IFS= read -rsn1 k || break
    if [ "$k" = $'\e' ]; then
      IFS= read -rsn2 -t 0.3 k2 2>/dev/null || k2=""
      case "$k2" in
        "[A"|"[D") sel=$(( (sel-1+n)%n ));;
        "[B"|"[C") sel=$(( (sel+1)%n ));;
        "") tput cnorm 2>/dev/null; exec 3>&-; return 255;;
      esac
    elif [ -z "$k" ]; then tput cnorm 2>/dev/null; echo "$sel" >&3; exec 3>&-; return 0;
    elif [ "$k" = q ]; then tput cnorm 2>/dev/null; exec 3>&-; return 255; fi
  done
  tput cnorm 2>/dev/null; exec 3>&- 2>/dev/null; return 255
}
menu(){
  local items=("add device" "status device" "logs" "remove" "test" "doctor" "exit") idx
  if [ ! -t 0 ] || ! command -v tput >/dev/null || [ "${TERM:-dumb}" = dumb ]; then
    while true; do
      echo "=== cuak === [1]add [2]status [3]logs [4]remove [5]test [6]doctor [7]exit"
      read -rp "pilih: " m || { echo "bye."; break; }
      case "$m" in 1)cmd_add;;2)cmd_status;;3)cmd_logs;;4)cmd_remove;;5)cmd_test;;6)cmd_doctor;;7|exit|q)echo bye.;break;;*)echo "pilihan 1-7.";;esac
    done; return
  fi
  while true; do
    idx=$(pick_idx "${items[@]}") || { echo "bye."; break; }
    case "$idx" in 0)cmd_add;;1)cmd_status;;2)cmd_logs;;3)cmd_remove;;4)cmd_test;;5)cmd_doctor;;6)echo "bye.";break;;esac
    read -rp "[Enter lanjut]" _ < /dev/tty || true
  done
  tput cnorm 2>/dev/null
}
case "${1:-}" in ""|menu) menu;; doctor) cmd_doctor;; add) cmd_add;; status) cmd_status;; logs) cmd_logs "$2";; remove) cmd_remove "$2";; test) cmd_test "$2";; *) echo "pakai: cuak [add|status|logs|remove|test|doctor]"; exit 1;; esac
